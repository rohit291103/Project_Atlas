  {
   "id": "1e42cf88-720a-4964-8499-297dd058cace",
   "type": "evidence",
   "content": "In the Vec::push benchmark example, LLVM optimized away the Vec allocation and the calls to push_cap, making the benchmark useless.",
   "confidence_score": 0.9,
   "status": "unconfirmed",
   "source_refs": [
    {
     "id": "df135ce2-8011-426b-982f-e177915ed334",
     "source_type": "gdoc",
     "external_id": "gdoc-rfc-2360",
     "url": "https://github.com/rust-lang/rfcs/blob/master/text/2360-bench-black-box.md",
     "excerpt": "LLVM is pretty amazing: it has optimized the `Vec` allocation and the calls to\n`push_cap` away. In doing so, it has made our benchmark useless.",
     "fetched_at": "2026-09-30T18:23:27.794057Z",
     "workspace_id": "00000000-0000-0000-0000-000000000000"
    }
   ],
   "created_by": "system",
