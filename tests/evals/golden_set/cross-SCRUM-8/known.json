   "status": "unconfirmed",
   "source_refs": [
    {
     "id": "30353e14-53ef-417a-93ce-227ef3e512cb",
     "source_type": "github_pr",
     "external_id": "111",
     "url": "https://github.com/BurntSushi/ripgrep/pull/111",
     "excerpt": "Could you just make sure we are consistent with GNU find?",
