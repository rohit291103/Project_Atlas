  {
   "id": "35ad0f48-02bc-4b7b-a714-d2ee1cad09b5",
   "type": "evidence",
   "content": "GNU find defines maxdepth as descending at most the given non-negative number of levels, with -maxdepth 0 applying only to the starting-points themselves.",
   "confidence_score": 0.9,
   "status": "unconfirmed",
   "source_refs": [
    {
     "id": "9348831f-0850-426e-81e2-5f0a292d9194",
     "source_type": "github_pr",
     "external_id": "111",
     "url": "https://github.com/BurntSushi/ripgrep/pull/111",
     "excerpt": "-maxdepth 0 means only apply the tests and actions to the starting-points themselves.",
     "fetched_at": "2026-07-27T17:56:04.606723Z",
     "workspace_id": "00000000-0000-0000-0000-000000000000"
    }
   ],
