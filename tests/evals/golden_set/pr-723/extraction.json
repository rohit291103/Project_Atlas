      "id": "794e789a-2428-43bb-a712-853f41e97d6c",
      "type": "constraint",
      "content": "Rust's format! macro cannot take a custom padding character as a parameter; only the width can be a parameter, so the padding character must be hard-coded in the format string.",
      "confidence_score": 0.9,
      "status": "unconfirmed",
      "source_refs": [
        {
          "id": "5d011bb1-cb82-47f3-9e4b-9d08a801706b",
          "source_type": "github_pr",
          "external_id": "723",
          "url": "https://github.com/BurntSushi/ripgrep/pull/723",
          "excerpt": "Rust's `format!` macro currently has no way of providing a custom padding character as a parameter. You have to provide it directly in the format string itself.",
          "fetched_at": "2026-07-27T17:58:14.190169Z",
          "workspace_id": "00000000-0000-0000-0000-000000000000"
        }
      ],
