+    /// Build a new `Checker` for incrementally testing individual file
+    /// paths.
+    ///
+    /// Unlike `build` and `build_parallel`, the `Checker` returned by this
+    /// method doesn't traverse a directory tree. Instead, given a specific
+    /// file path, it reports whether that one path would be included or
+    /// ignored by this builder's configuration (overrides, ignore files,
+    /// including those in parent directories, and file type rules), without
+    /// visiting any other paths.
+    ///
+    /// This is useful in cases where a full directory traversal isn't
+    /// necessary or desirable. A canonical example is a file watcher: when
+    /// a new path is observed, a `Checker` can be asked whether that path
+    /// should be ignored, without re-walking the directory tree that's
+    /// being watched.
+    ///
+    /// Note that the paths added via `WalkBuilder::add` have no effect on
+    /// the `Checker` returned here; a `Checker` can check any path
+    /// regardless of what (if anything) was added to this builder.
+    pub fn build_checker(&self) -> Checker {
+        let ig_root = self
+            .get_or_set_current_dir()
+            .map(|cwd| self.ig_builder.build_with_cwd(Some(cwd.to_path_buf())))
+            .unwrap_or_else(|| self.ig_builder.build());
+        Checker::new(ig_root)
+    }
