+/// Checker provides a way to check individual file paths for whether they
+/// should be ignored or not, without requiring a full traversal of a
+/// directory tree.
+///
+/// This is useful in contexts where paths become known incrementally, such
+/// as a file watcher: when a new path is observed, a `Checker` can be asked
+/// whether that specific path should be included or ignored, according to
+/// the overrides, ignore files (including any found in parent directories)
+/// and file type rules that were used to build it, without re-walking the
+/// directory tree from scratch.
+///
+/// Internally, a `Checker` lazily builds and caches the ignore matchers for
+/// every directory it's asked about (and their ancestors), so that
+/// subsequent checks for paths that share common ancestor directories don't
+/// require re-parsing the same ignore files over and over again.
+///
+/// A `Checker` is created via `WalkBuilder::build_checker`.
+#[derive(Clone, Debug)]
+pub struct Checker {
+    /// The matcher with no parent directories added to it. This is used as
+    /// the starting point for discovering and building matchers for the
+    /// ancestors of any directory this checker is asked about.
+    root: Ignore,
+    /// A cache of matchers for directories this checker has already seen,
+    /// keyed by each directory's canonicalized path. Each matcher here
+    /// corresponds to the state of `root` with that specific directory (and
+    /// all of its ancestors) added via `add_parents` and `add_child`.
+    dirs: HashMap<PathBuf, Ignore>,
+}
+
+impl Checker {
+    /// Create a new checker from the given root matcher.
+    ///
+    /// The root matcher should have no parent directories, i.e., it should
+    /// be fresh from `IgnoreBuilder::build` or `IgnoreBuilder::build_with_cwd`.
+    pub(crate) fn new(root: Ignore) -> Checker {
+        Checker { root, dirs: HashMap::new() }
+    }
+
+    /// Returns true if and only if the given file path should be ignored.
+    ///
+    /// `is_dir` should be true if the path refers to a directory and false
+    /// otherwise.
+    ///
+    /// If the parent directory of `path` doesn't exist (and therefore can't
+    /// be canonicalized), then this returns `false`.
+    pub fn is_ignored<P: AsRef<Path>>(
+        &mut self,
+        path: P,
+        is_dir: bool,
+    ) -> bool {
+        self.matched(path, is_dir).is_ignore()
+    }
+
+    /// Returns a match indicating whether the given path should be ignored
+    /// or whitelisted.
+    ///
+    /// This applies the same precedence rules (overrides, then ignore
+    /// files, then file types, then hidden file handling) that are used
+    /// when walking a directory tree with `Walk` or `WalkParallel`. See the
+    /// documentation on `WalkBuilder` for the details of those rules.
+    ///
+    /// `is_dir` should be true if the path refers to a directory and false
+    /// otherwise.
+    ///
+    /// If the parent directory of `path` doesn't exist (and therefore can't
+    /// be canonicalized), then this returns `Match::None`.
+    pub fn matched<P: AsRef<Path>>(
+        &mut self,
+        path: P,
+        is_dir: bool,
+    ) -> Match<()> {
+        let path = path.as_ref();
+        let Some(file_name) = path.file_name() else { return Match::None };
+        let parent = match path.parent() {
+            Some(parent) if !parent.as_os_str().is_empty() => parent,
+            _ => Path::new("."),
+        };
+        let Some((ig, dir)) = self.ignore_for_dir(parent) else {
+            return Match::None;
+        };
+        // We rebuild the candidate path from the canonicalized directory we
+        // found a matcher for, joined with the requested file name. This
+        // means the matcher (whose own directory and ancestors are all
+        // absolute, canonicalized paths) is able to correctly strip common
+        // prefixes when matching against each ignore file it checks,
+        // regardless of whether the path given to this method was relative
+        // or absolute. Notably, this also means `path` itself need not
+        // exist (only its parent directory needs to), which matters for
+        // callers like file watchers that may want to check a path that
+        // was just removed.
+        let candidate = dir.join(file_name);
+        let m = ig.matched(&candidate, is_dir).map(|_| ());
+        if m.is_none() && ig.inner.opts.hidden && is_hidden_path(&candidate) {
+            return Match::Ignore(());
+        }
+        m
+    }
+
+    /// Returns the ignore matcher for the given directory, along with its
+    /// canonicalized path, building and caching it (and its ancestors) if
+    /// it isn't already cached.
+    fn ignore_for_dir(&mut self, dir: &Path) -> Option<(Ignore, PathBuf)> {
+        let dir = match dir.canonicalize() {
+            Ok(dir) => dir,
+            Err(_) => return None,
+        };
+        if let Some(ig) = self.dirs.get(&dir) {
+            return Some((ig.clone(), dir));
+        }
+        let (ancestors, err) = self.root.add_parents(&dir);
+        if let Some(err) = err {
+            log::debug!("{}", err);
+        }
+        let (ig, err) = ancestors.add_child(&dir);
+        if let Some(err) = err {
+            log::debug!("{}", err);
+        }
+        self.dirs.insert(dir.clone(), ig.clone());
+        Some((ig, dir))
+    }
+}
