+    #[test]
+    fn checker_directory_ignored_by_parent_not_itself() {
+        let td = tmpdir();
+        mkdirp(td.path().join(".git"));
+        mkdirp(td.path().join("target"));
+        wfile(td.path().join(".gitignore"), "target\n");
+        // Even though `target`'s own ignore file whitelists everything, that
