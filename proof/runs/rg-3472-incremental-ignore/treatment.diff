+    /// Build a new `Checker`.
+    ///
+    /// Unlike `Walk` and `WalkParallel`, a `Checker` does not traverse a
+    /// directory tree. Instead, it can be used to check individual file
+    /// paths, given directly to `Checker::match_path`, for whether they
+    /// are ignored. This is done using the same ignore rules, overrides and
+    /// file type filters that a directory traversal built from this
+    /// `WalkBuilder` would use, including any parent gitignores. This makes
+    /// it possible to check whether a file path is ignored without doing a
+    /// full traversal of the directory tree that path resides in, which is
+    /// particularly useful in contexts such as a file watcher.
+    ///
+    /// Note that the paths added to this builder via `WalkBuilder::add` have
+    /// no effect on the `Checker` returned here.
+    pub fn build_checker(&self) -> Checker {
+        Checker::new(self.build_ig_root())
+    }
+
+    /// Builds the root `Ignore` matcher shared by `Walk`, `WalkParallel` and
+    /// `Checker`.
+    fn build_ig_root(&self) -> Ignore {
+        self.get_or_set_current_dir()
+            .map(|cwd| self.ig_builder.build_with_cwd(Some(cwd.to_path_buf())))
