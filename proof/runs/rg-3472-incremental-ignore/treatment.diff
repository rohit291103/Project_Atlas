+    /// Like `matched`, but works with a plain path instead of a directory
+    /// entry.
+    ///
+    /// This is used for incremental checking of individual file paths (see
+    /// the `Checker` type), where a `DirEntry` produced by a directory
+    /// traversal might not be available.
+    pub(crate) fn matched_path<'a, P: AsRef<Path>>(
+        &'a self,
+        path: P,
+        is_dir: bool,
+    ) -> Match<IgnoreMatch<'a>> {
+        let path = path.as_ref();
+        let m = self.matched(path, is_dir);
+        if m.is_none() && self.inner.opts.hidden && is_hidden_path(path) {
+            return Match::Ignore(IgnoreMatch::hidden());
+        }
+        m
+    }
