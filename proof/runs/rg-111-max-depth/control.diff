+// See: https://github.com/BurntSushi/ripgrep/issues/109
+#[test]
+fn max_depth() {
+    let wd = WorkDir::new("max_depth");
+    wd.create("a", "test");
+    wd.create_dir("one");
+    wd.create("one/a", "test");
+    wd.create_dir("one/two");
+    wd.create("one/two/a", "test");
+
+    // A depth of 1 should only search the starting-point itself (and
+    // anything directly inside it), so the file nested inside "one"
+    // should not be found.
+    let mut cmd = wd.command();
+    cmd.arg("test").arg("--maxdepth").arg("1");
+    let lines: String = wd.stdout(&mut cmd);
+    assert_eq!(lines, path("a:test\n"));
+
+    // A depth of 2 should find files nested one directory below a
+    // starting-point, but should still ignore anything deeper than that.
+    let mut cmd = wd.command();
+    cmd.arg("test").arg("--maxdepth").arg("2");
+    let out: String = wd.stdout(&mut cmd);
+    assert_eq!(sort_lines(&out), sort_lines(&path("a:test\none/a:test\n")));
+}
