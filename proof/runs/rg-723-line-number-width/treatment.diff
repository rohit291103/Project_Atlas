@@ -578,3 +586,12 @@ lazy_static! {
 fn validate_number(s: String) -> Result<(), String> {
     s.parse::<usize>().map(|_|()).map_err(|err| err.to_string())
 }
+
+fn validate_line_number_width(s: String) -> Result<(), String> {
+    if s.starts_with('0') {
+        return Err(format!(
+            "invalid line number padding width '{}': width cannot start \
+             with a zero", s));
+    }
+    validate_number(s)
+}
