ANTHROPIC_API_KEY=
GITHUB_TOKEN=
# postgresql://<user>:<password>@<host>:5432/postgres -- percent-encode any
# @, :, or / in the password itself, or URL parsing will mis-split it.
#
# Two URLs, because they are two different privilege levels (migration
# c3d8e1f60b21). The application connects as `atlas_app`, which is NOBYPASSRLS
# and holds SELECT+INSERT on event_log and nothing else -- that is what makes
# the row-level-security policy actually bind and the event log actually
# append-only. Migrations need DDL, so they use the owner URL instead.
#
# On a hosted Supabase project use the **pooler** host
# (aws-<n>-<region>.pooler.supabase.com, username `<role>.<project-ref>`):
# db.<project-ref>.supabase.co publishes only an AAAA record, so it is
# unreachable from any network without working IPv6.
SUPABASE_DB_URL=
# Owner/DDL rights -- Alembic only. Never used by the application or the API.
SUPABASE_DB_ADMIN_URL=
# The password for the `atlas_app` role. Read by migration c3d8e1f60b21 when it
# creates the role; must match the password inside SUPABASE_DB_URL.
ATLAS_DB_APP_PASSWORD=

# --- API only (slice 1B). The API process needs these and deliberately NOT
# GITHUB_TOKEN: it never reaches a source system, so it holds no credential for
# one (src/atlas/config.py::ApiSettings).
# The shared passphrase the reviewer types on the sign-in screen.
ATLAS_APP_PASSPHRASE=
# Signs the session cookie. Any long random string; rotating it signs everyone out.
ATLAS_SESSION_SECRET=
# Set to 1 only in local dev, to allow the Vite dev server's origin (:5173).
ATLAS_DEV_CORS=

# --- Jira, the second source (slice 1C). Email + API token, not OAuth:
# the token carries exactly its owner's permissions, which is least privilege
# with no scope negotiation (src/atlas/ingestion/jira.py).
JIRA_BASE_URL=https://your-site.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
