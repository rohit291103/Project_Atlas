ANTHROPIC_API_KEY=
GITHUB_TOKEN=
# postgresql://<user>:<password>@<host>:5432/postgres -- percent-encode any
# @, :, or / in the password itself, or URL parsing will mis-split it.
SUPABASE_DB_URL=

# --- API only (slice 1B). The API process needs these and deliberately NOT
# GITHUB_TOKEN: it never reaches a source system, so it holds no credential for
# one (src/atlas/config.py::ApiSettings).
# The shared passphrase the reviewer types on the sign-in screen.
ATLAS_APP_PASSPHRASE=
# Signs the session cookie. Any long random string; rotating it signs everyone out.
ATLAS_SESSION_SECRET=
# Set to 1 only in local dev, to allow the Vite dev server's origin (:5173).
ATLAS_DEV_CORS=

# --- Jira, the second source (slice 1C). Email + API token, not OAuth:
# the token carries exactly its owner's permissions, which is least privilege
# with no scope negotiation (src/atlas/ingestion/jira.py).
JIRA_BASE_URL=https://your-site.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
